{
  "name": "dark-oak",
  "version": "0.0.0",
  "description": "Dark Oak",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron --no-sandbox electron/main.cjs",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "start": "electron --no-sandbox electron/main.cjs",
    "dist": "vite build && electron-builder --win",
    "release": "node scripts/release.mjs"
  },
  "keywords": [],
  "author": "MarzVoid",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@marzipan/updater": "file:./packages/updater",
    "axios": "^1.7.9",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "^1.15.1"
  },
  "build": {
    "appId": "com.darkoak.recipes",
    "productName": "Dark Oak",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "packages/updater/dist/**/*",
      "node_modules/@marzipan/updater/dist/**/*",
      "node_modules/sql.js/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": false
    }
  }
}
